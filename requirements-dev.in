# Development dependencies — pinned via pip-tools.
#
# Regenerate the lockfile with:
#   pip-compile --strip-extras requirements-dev.in -o requirements-dev.lock
#
# Run-time deps come from the project's pyproject.toml [project.dependencies]
# (mirrored in requirements.txt). dev tooling lives here so it does not bleed
# into the shipped wheel / PyInstaller bundle.

-r requirements.txt

